# Copy to .env and fill in. All variables are prefixed SSR_.
# Only needed for grounded answers (/answer) and the LLM-as-judge RAG eval —
# the entire retrieval core, the UI's search, and `make eval` run without any of this.
# The model ids are code defaults (app/core/config.py), not .env values.

# --- Mistral (default generator: ministral-14b-latest, fallback ministral-8b-latest) ---
# Free tier ("Experiment" plan): ministral-14b allows 30 req/min. The key only ever goes to
# https://api.mistral.ai/v1.
SSR_MISTRAL_API_KEY=...
# SSR_MISTRAL_LLM_MODEL=ministral-14b-latest          # a different model is never canonical
# SSR_MISTRAL_LLM_FALLBACK_MODEL=ministral-8b-latest   # tried once if the primary call fails; empty = off

# --- OpenRouter (default judge for the RAG eval: nvidia/nemotron-3-ultra-550b-a55b:free) ---
# Free models only ($0; every request is checked by a free-only guard).
# Free tier: 20 req/min, and 1,000 req/day account-wide only on accounts that have ever bought
# >= $10 of credits. Set a credit limit on the key in the OpenRouter dashboard as a backstop.
SSR_OPENROUTER_API_KEY=sk-or-...
# Generator on OpenRouter instead of Mistral (a free model id; ":free" is appended):
# SSR_LLM_PROVIDER=openrouter
# SSR_OPENROUTER_LLM_MODEL=...

# --- Any OpenAI-compatible endpoint instead (provider "openai_compat"), e.g. Groq ---
# SSR_LLM_PROVIDER=openai_compat      # generator
# SSR_JUDGE_PROVIDER=openai_compat    # judge
# SSR_LLM_BASE_URL=https://api.groq.com/openai/v1
# SSR_LLM_API_KEY=gsk_...
# SSR_LLM_MODEL=...                   # generator model on that endpoint
# SSR_JUDGE_MODEL=...                 # judge model; keep it a different family from the generator

# --- Local Ollama alternative ---
# SSR_LLM_PROVIDER=openai_compat
# SSR_LLM_BASE_URL=http://localhost:11434/v1
# SSR_LLM_MODEL=qwen3:4b
# SSR_LLM_API_KEY=not-needed-for-local

# --- API behind a reverse proxy (rate limits key on the client IP) ---
# Enable only behind a proxy you control, and set the hop count to exactly the number of
# proxies you run (too high lets clients choose their own rate-limit key).
# SSR_TRUST_PROXY=true
# SSR_TRUSTED_PROXY_HOPS=1
