# Copy to .env and fill in. All variables are prefixed SSR_.
# Only needed for grounded answers (/answer) and the LLM-as-judge RAG eval —
# the entire retrieval core, the UI's search, and `make eval` run without any of this.
# Model names are code defaults (app/core/config.py), not .env values.

# --- OpenRouter (default for both the generator and the judge) ---
# Both roles are free by default: the inclusionai/ling-3.0-flash-sante:free generator and the
# nvidia/nemotron-3-ultra-550b-a55b:free judge ($0; free tier 20 req/min and 1,000 req/day
# account-wide, on accounts that have ever bought >= $10 of credits). Set a credit limit on the key in the OpenRouter dashboard as a backstop.
SSR_OPENROUTER_API_KEY=sk-or-...
# Optional PAID generator (the model behind the earlier committed numbers), allowlisted and
# always sent with pinned, price-capped, no-fallback routing; rag_eval also enforces
# SSR_RAG_MAX_SPEND_USD. Any non-allowlisted id is sent as its `:free` variant instead.
# SSR_OPENROUTER_LLM_MODEL=openai/gpt-oss-120b

# --- Groq alternative (provider "groq" = any OpenAI-compatible endpoint) ---
# SSR_LLM_PROVIDER=groq      # generator
# SSR_JUDGE_PROVIDER=groq    # judge
# SSR_LLM_BASE_URL=https://api.groq.com/openai/v1
# SSR_LLM_API_KEY=gsk_...    # also needed for judge_agreement's provider comparison

# --- Local Ollama alternative ---
# SSR_LLM_PROVIDER=groq
# SSR_LLM_BASE_URL=http://localhost:11434/v1
# SSR_LLM_MODEL=qwen3:4b
# SSR_LLM_API_KEY=not-needed-for-local

# --- Semantic Scholar web search (optional modes `web` / `hybrid_web`, and `make web-eval`) ---
# Works without a key via S2's shared public pool, which often returns 429. A free key
# (https://www.semanticscholar.org/product/api#api-key-form) is sent as `x-api-key`, only to
# api.semanticscholar.org; its introductory limit is 1 request/s, which SSR_S2_RATE_PER_S enforces.
SSR_S2_API_KEY=
# SSR_S2_API_CACHE=true      # also cache the API's S2 responses under data/s2_cache/ (off by default)

# --- PubMed (part of the web pool; works without these) ---
# NCBI asks E-utilities users to identify themselves with an email (sent only when set).
# An NCBI API key raises the limit from 3 to 10 requests/s, but this app caps PubMed at
# 3 req/s (SSR_PUBMED_RATE_PER_S, default 2): to go higher with a key, raise the le=3.0
# bound on pubmed_rate_per_s in app/core/config.py, then set that variable (max 10).
# SSR_NCBI_EMAIL=you@example.org
# SSR_NCBI_API_KEY=

# --- Web-mode API guards and bounds (API only; `make web-eval` uses none of these) ---
# SSR_WEB_RATE_LIMIT=6/minute          # per-IP limit on web-mode requests (/search + /answer share it); 429 past it
# SSR_WEB_MAX_CONCURRENT=2             # web searches running at once per process; extra ones get 503 + Retry-After
# SSR_WEB_DEADLINE_S=20                # time budget per pooled web search; slower extra sources are dropped (0 = no limit)
# SSR_WEB_API_DENSE_CAP=30             # max candidates embedded per web request (0 = only SSR_WEB_DENSE_CAP, 50)
# SSR_WEB_SNIPPET_DATASET_FILTER=true  # drop S2 snippets that look like a SciFact dataset dump
